@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @{
                        // Get the requested path
                        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
                        
                        // List of pages that don't require authentication
                        var publicPages = new[] { "", "login", "register", "logout" };
                        
                        // If trying to access a protected page, redirect to login
                        if (!publicPages.Contains(returnUrl.ToLower().TrimEnd('/')))
                        {
                            Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
                        }
                        else
                        {
                            // Show not authorized message for public pages
                            <div class="container mt-5">
                                <Alert Color="AlertColor.Warning">
                                    <Icon Name="IconName.ExclamationTriangleFill" class="me-2" />
                                    You are not authorized to view this page. Please <a href="/login">login</a> to continue.
                                </Alert>
                            </div>
                        }
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

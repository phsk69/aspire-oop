@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthenticationStateProvider
@implements IDisposable

<div class="page">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="">AspireDeezNuts</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                            <Icon Name="IconName.HouseDoorFill" /> Home
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="counter">
                            <Icon Name="IconName.PlusSquareFill" /> Counter
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="posts">
                            <Icon Name="IconName.ListNested" /> Posts
                        </NavLink>
                    </li>
                    <AuthorizeView>
                        <Authorized>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="profile">
                                    <Icon Name="IconName.PersonCircle" /> Profile
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <li class="nav-item">
                                <NavLink class="nav-link" href="admin/users">
                                    <Icon Name="IconName.PeopleFill" /> User Admin
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                </ul>
                <div class="navbar-nav ms-auto">
                    <LoginDisplay />
                </div>
            </div>
        </div>
    </nav>

    <main>
        <div class="container mt-3">
            @Body
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<AspireDeezNuts.Web.Components.Shared.ToastContainer />

@code {
    private readonly Timer _debounceTimer;
    private readonly object _debouneLock = new();
    private volatile bool _pendingStateChange = false;

    public MainLayout()
    {
        // Create a debounce timer to prevent excessive re-renders
        _debounceTimer = new Timer(OnDebouncedStateChange, null, Timeout.Infinite, Timeout.Infinite);
    }

    protected override void OnInitialized()
    {
        // Subscribe to authentication state changes to refresh the layout
        AuthenticationStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> task)
    {
        lock (_debouneLock)
        {
            _pendingStateChange = true;
            // Debounce for 100ms to prevent rapid successive re-renders
            _debounceTimer.Change(100, Timeout.Infinite);
        }
    }

    private async void OnDebouncedStateChange(object? state)
    {
        lock (_debouneLock)
        {
            if (!_pendingStateChange) return;
            _pendingStateChange = false;
        }

        // Force the layout to re-render when authentication state changes (debounced)
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Unsubscribe from authentication state changes to prevent memory leaks
        AuthenticationStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
        _debounceTimer?.Dispose();
    }
}
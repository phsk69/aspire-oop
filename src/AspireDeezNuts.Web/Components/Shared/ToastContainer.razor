@using BlazorBootstrap
@implements IDisposable
@inject IToastService ToastService
@inject ILogger<ToastContainer> Logger
@rendermode InteractiveServer

<Toasts class="p-3" Messages="toastMessages" Placement="ToastsPlacement.TopRight" />

@code {
    private List<ToastMessage> toastMessages = new();
    private int _lastToastCount = 0;

    private bool _subscribed = false;

    protected override void OnInitialized()
    {
        Logger.LogDebug("ToastContainer OnInitialized - subscribing to ToastService");
        ToastService.OnShow += ShowToast;
        _subscribed = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_subscribed)
        {
            Logger.LogDebug("ToastContainer OnAfterRenderAsync (firstRender) - subscribing to ToastService");
            ToastService.OnShow += ShowToast;
            _subscribed = true;
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override bool ShouldRender()
    {
        // Only re-render if the number of toast messages has changed
        var currentCount = toastMessages.Count;
        var shouldRender = currentCount != _lastToastCount;
        _lastToastCount = currentCount;
        
        Logger.LogDebug("ToastContainer ShouldRender: {ShouldRender} (messages: {Count})", shouldRender, currentCount);
        return shouldRender;
    }

    private void ShowToast(ToastMessage message)
    {
        Logger.LogDebug("ToastContainer.ShowToast called: {Type} - {Message}", message.Type, message.Message);
        toastMessages.Add(message);
        Logger.LogDebug("ToastContainer now has {Count} messages", toastMessages.Count);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Logger.LogDebug("ToastContainer disposing - unsubscribing from ToastService");
        ToastService.OnShow -= ShowToast;
    }
}